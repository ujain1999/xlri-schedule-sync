# Postgres
POSTGRES_USER=xlri_sync
POSTGRES_PASSWORD=changeme
POSTGRES_DB=xlri_sync
DATABASE_URL=postgresql+asyncpg://xlri_sync:changeme@db:5432/xlri_sync

# Fernet key for encrypting XLRI passwords + Google refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up SEPARATELY from database backups -- losing it makes all encrypted data unrecoverable.
ENCRYPTION_KEY=

# Random secret for the transient OAuth-handshake session cookie (state/nonce only,
# NOT the long-lived login session -- that's a server-side table, see app/services/session.py).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

BASE_URL=http://localhost:8000

# Cloudflare Tunnel token (production only, cloudflared container)
CLOUDFLARE_TUNNEL_TOKEN=
